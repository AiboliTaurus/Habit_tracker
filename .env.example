# Django Secret Key (сгенерируйте свой уникальный ключ)
# Для генерации: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-***ЗАМЕНИТЕ НА РЕАЛЬНЫЙ КЛЮЧ***

# Django Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database
DB_NAME=habit_tracker_db
DB_USER=postgres
DB_PASSWORD=***ЗАМЕНИТЕ НА РЕАЛЬНЫЙ ПАРОЛЬ***
DB_HOST=localhost
DB_PORT=5432

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Telegram Bot (зарегистрируйте бота у @BotFather)
# 1. Напишите /newbot в @BotFather
# 2. Укажите имя бота (например: HabitTrackerBot)
# 3. Укажите username бота (должен заканчиваться на _bot, например: yourname_habittracker_bot)
# 4. Скопируйте полученный токен
TELEGRAM_BOT_TOKEN=***ЗАМЕНИТЕ НА ТОКЕН ОТ BOTFATHER***
TELEGRAM_BOT_USERNAME=***ЗАМЕНИТЕ НА USERNAME БОТА***
TELEGRAM_BOT_NAME=ЗАМЕНИТЕ НА СВОЙ

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Time Zone
TIME_ZONE=Europe/Moscow